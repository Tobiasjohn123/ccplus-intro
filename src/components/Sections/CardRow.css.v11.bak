.cr-wrap { background: #eaefff; color: var(--ink); font-family: "Bricolage Grotesque", sans-serif; padding: clamp(48px, 6vw, 88px) clamp(20px, 2vw, 40px) 0; }
.cr-wrap a { color: inherit; text-decoration: none; }
.cr-in { max-width: 1400px; margin: 0 auto; }

.cr-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; flex-wrap: wrap; margin-bottom: clamp(22px, 3vw, 36px); }
.cr-kicker { display: inline-flex; align-items: center; gap: 8px; padding: 8px 18px; border-radius: 99px; background: #fff; font-size: 13px; font-weight: 700; border: 1px solid rgba(61,59,255,.14); box-shadow: 0 8px 20px rgba(40,50,140,.08); margin-bottom: 16px; }
.cr-kicker i { width: 9px; height: 9px; border-radius: 50%; background: var(--blue); display: block; }
.cr-h { font-family: var(--font-head); font-weight: 700; font-size: clamp(32px, 4.4vw, 64px); line-height: 1.03; letter-spacing: -.035em; margin: 0; }
.cr-h mark { background: linear-gradient(transparent 68%, var(--gold) 68% 92%, transparent 92%); color: inherit; -webkit-box-decoration-break: clone; box-decoration-break: clone; }
.cr-sub { margin: 14px 0 0; max-width: 560px; color: var(--mut); font-size: clamp(15px, 1.3vw, 18px); line-height: 1.55; }
.cr-all { display: inline-flex; align-items: center; justify-content: center; gap: 8px; height: 52px; padding: 0 24px; border-radius: 99px; border: 1.5px solid var(--ink); font-size: 16px; font-weight: 700; white-space: nowrap; transition: transform .5s var(--smooth), background .4s var(--smooth), color .4s var(--smooth); }
.cr-all:hover { background: var(--ink); color: #fff; transform: translateY(-3px); }

.cr { --h: clamp(260px, 24vw, 380px); display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); grid-auto-rows: var(--h); gap: clamp(12px, 1.5vw, 22px); }
.cr-tile { position: relative; display: block; border-radius: 28px; overflow: hidden; background: #dfe5ff; box-shadow: 0 14px 30px rgba(30,40,120,.14); transition: transform .6s var(--smooth), box-shadow .6s var(--smooth); }
.cr-tile:hover { transform: translateY(-8px); box-shadow: 0 28px 50px rgba(30,40,120,.26); }
.cr-tile img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 1s var(--smooth); }
.cr-tile:hover img { transform: scale(1.06); }
.cr-tile::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 45%, rgba(10,15,60,.4)); pointer-events: none; }
.cr-cap { position: absolute; z-index: 2; left: 12px; right: 12px; bottom: 12px; display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 12px 12px 12px 16px; border-radius: 18px; background: rgba(255,255,255,.94); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); }
.cr-txt { min-width: 0; display: flex; flex-direction: column; gap: 2px; }
.cr-txt b { font-size: 16px; color: var(--ink); line-height: 1.2; }
.cr-txt small { font-size: 12.5px; font-weight: 500; color: var(--mut); line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.cr-go { flex: none; width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; background: var(--blue); color: #fff; transition: transform .6s var(--smooth); }
.cr-tile:hover .cr-go { transform: rotate(-45deg); }

.cr-stat { display: flex; flex-direction: column; justify-content: space-between; padding: 24px 26px; border-radius: 28px; color: #fff; background: var(--blue); -webkit-mask: radial-gradient(circle 38px at 100% 0, transparent 98%, #000 100%); mask: radial-gradient(circle 38px at 100% 0, transparent 98%, #000 100%); transition: transform .6s var(--smooth), filter .6s var(--smooth); }
.cr-stat:hover { transform: translateY(-8px); filter: brightness(1.1); }
.cr-stat__top { display: flex; flex-direction: column; gap: 10px; }
.cr-stat__top strong { font-family: var(--font-2); font-weight: 400; font-size: clamp(64px, 6.4vw, 108px); line-height: .9; }
.cr-stat__top small { font-size: 12px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: rgba(255,255,255,.88); }
.cr-stat__bot { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-top: 14px; border-top: 1px solid rgba(255,255,255,.25); }
.cr-stat__ico { display: flex; gap: 8px; }
.cr-stat__ico i { width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center; background: rgba(255,255,255,.16); border: 1px solid rgba(255,255,255,.35); }
.cr-stat__from { font-size: 14px; font-weight: 700; white-space: nowrap; }

@media (max-width: 1000px) {
  .cr { grid-template-columns: 1fr 1fr; grid-auto-rows: 220px; gap: 14px; }
  .cr-stat { grid-column: 1 / -1; min-height: 180px; }
  .cr-stat:hover { transform: none; }
  .cr-stat__top { flex-direction: row; align-items: baseline; gap: 14px; flex-wrap: wrap; }
  .cr-stat__top strong { font-size: clamp(56px, 12vw, 80px); }
  .cr-all { width: 100%; }
}
@media (max-width: 600px) {
  .cr { grid-auto-rows: 210px; }
  .cr-txt small, .cr-go { display: none; }
  .cr-txt b { font-size: 15px; }
  .cr-cap { left: 10px; right: 10px; bottom: 10px; padding: 12px 14px; }
}