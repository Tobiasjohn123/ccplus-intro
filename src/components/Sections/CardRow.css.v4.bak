.cr-wrap { background: #eaefff; color: var(--ink); font-family: "Bricolage Grotesque", sans-serif; padding-top: clamp(14px, 2.4vw, 34px); }
.cr-wrap a { text-decoration: none; }

.cr { --h: clamp(250px, 25vw, 400px); max-width: 1400px; margin: 0 auto; padding: 0 clamp(16px, 2vw, 40px); display: grid; grid-template-columns: minmax(0, 1.42fr) minmax(0, 1fr) minmax(0, 1.46fr) minmax(0, 1fr) minmax(0, 1.42fr); gap: clamp(12px, 1.5vw, 24px); align-items: end; }

.cr-tile { position: relative; display: block; border-radius: 28px; overflow: hidden; background: #dfe5ff; box-shadow: 0 14px 30px rgba(30,40,120,.14); transition: transform .6s var(--smooth), box-shadow .6s var(--smooth); }
.cr-1, .cr-4 { height: var(--h); }
.cr-2, .cr-3 { height: calc(var(--h) * .78); }
.cr-tile:hover { transform: translateY(-8px); box-shadow: 0 28px 50px rgba(30,40,120,.26); }
.cr-tile img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 1s var(--smooth); }
.cr-tile:hover img { transform: scale(1.06); }
.cr-tile::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 45%, rgba(10,15,60,.4)); pointer-events: none; }
.cr-tile:focus-visible, .cr-stat:focus-visible { outline: 3px solid var(--blue); outline-offset: 4px; }

.cr-cap { position: absolute; z-index: 2; left: 12px; right: 12px; bottom: 12px; display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 12px 12px 12px 16px; border-radius: 18px; background: rgba(255,255,255,.92); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); transition: transform .6s var(--smooth); }
.cr-tile:hover .cr-cap { transform: translateY(-3px); }
.cr-txt { min-width: 0; display: flex; flex-direction: column; gap: 2px; }
.cr-txt b { font-size: 16px; color: var(--ink); line-height: 1.2; }
.cr-txt small { font-size: 12.5px; font-weight: 500; color: var(--mut); line-height: 1.25; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.cr-go { flex: none; width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; background: var(--blue); color: #fff; transition: transform .6s var(--smooth); }
.cr-tile:hover .cr-go { transform: rotate(-45deg); }

.cr-stat { height: calc(var(--h) * .6); min-height: 150px; display: flex; flex-direction: column; justify-content: space-between; padding: 22px 26px; border-radius: 28px; color: #fff; background: var(--blue); -webkit-mask: radial-gradient(circle 38px at 100% 0, transparent 98%, #000 100%); mask: radial-gradient(circle 38px at 100% 0, transparent 98%, #000 100%); transition: transform .6s var(--smooth), filter .6s var(--smooth); }
.cr-stat:hover { transform: translateY(-8px); filter: brightness(1.1); }
.cr-stat__top { display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap; }
.cr-stat__top strong { font-family: var(--font-2); font-weight: 400; font-size: clamp(48px, 5vw, 84px); line-height: .9; }
.cr-stat__top small { font-size: 12px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: rgba(255,255,255,.88); }
.cr-stat__bot { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-top: 12px; border-top: 1px solid rgba(255,255,255,.25); }
.cr-stat__ico { display: flex; gap: 8px; }
.cr-stat__ico i { width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center; background: rgba(255,255,255,.16); border: 1px solid rgba(255,255,255,.35); }
.cr-stat__from { font-size: 14px; font-weight: 700; white-space: nowrap; }

@media (max-width: 1000px) {
  .cr { grid-template-columns: 1fr 1fr; align-items: stretch; }
  .cr-1, .cr-2, .cr-3, .cr-4 { height: 210px; }
  .cr-stat { grid-column: 1 / -1; height: auto; min-height: 170px; }
  .cr-stat:hover { transform: none; }
}
@media (max-width: 600px) {
  .cr-1, .cr-2, .cr-3, .cr-4 { height: 200px; }
  .cr-txt small { display: none; }
  .cr-txt b { font-size: 14px; }
  .cr-cap { left: 8px; right: 8px; bottom: 8px; padding: 8px 8px 8px 12px; }
  .cr-go { width: 30px; height: 30px; }
  .cr-stat { padding: 18px 20px; }
}