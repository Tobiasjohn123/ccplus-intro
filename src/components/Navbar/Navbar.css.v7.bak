.brand { display: inline-flex; align-items: center; gap: 10px; }
.brand svg { display: none; }
.brand::before { content: ""; flex: none; width: 60px; height: 52px; background: url('https://www.computercollegeplus.com/computerplus-logo.png') center / contain no-repeat; mix-blend-mode: multiply; }
.brand b { font-size: 17px; font-weight: 800; letter-spacing: -.02em; }

.nav { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 8px 12px 8px 18px; border-radius: 99px; }
.nav__links { display: flex; gap: 4px; }
.nav__links a { padding: 9px 16px; border-radius: 99px; font-size: 14px; font-weight: 600; color: var(--mut); transition: background .4s var(--smooth), color .4s var(--smooth); }
.nav__links a:hover, .nav__links a.on { background: #fff; color: var(--ink); }
.nav__reg { padding: 11px 22px; font-size: 14px; }

.bnav { display: none; }

@media (max-width: 1000px) {
  .nav { display: none; }
  .bnav { display: flex; align-items: center; gap: 2px; position: fixed; z-index: 60; left: 12px; right: 12px; max-width: 460px; margin: 0 auto; bottom: calc(12px + env(safe-area-inset-bottom, 0px)); padding: 6px; border-radius: 30px; }
  .bnav a { flex: 1; min-width: 0; height: 56px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; border-radius: 24px; font-size: 11px; font-weight: 700; color: var(--mut); transition: background .4s var(--smooth), color .4s var(--smooth); }
  .bnav a.on { color: var(--blue); }
  .bnav a.reg { flex: 1.1; background: var(--blue); color: #fff; box-shadow: 0 10px 22px rgba(61,59,255,.4); }
}