.brand { display: inline-flex; align-items: center; gap: 10px; }
.brand svg { display: none; }
.brand::before { content: ""; flex: none; width: 60px; height: 52px; background: url('https://www.computercollegeplus.com/computerplus-logo.png') center / contain no-repeat; mix-blend-mode: multiply; }
.brand b { font-size: 17px; font-weight: 800; letter-spacing: -.02em; }

.nav { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 8px 12px 8px 18px; border-radius: 99px; }
.nav__links { display: flex; gap: 4px; }
.nav .nav__links a { padding: 9px 16px; border-radius: 99px; font-size: 14px; font-weight: 600; color: var(--mut); transition: background .4s var(--smooth), color .4s var(--smooth); }
.nav .nav__links a:hover, .nav .nav__links a.on { background: #fff; color: var(--ink); }
.nav .nav__reg { padding: 11px 22px; font-size: 14px; color: #fff; background: var(--ink); }
.nav .nav__reg:hover { color: #fff; }

.bnav { display: none; }

@media (max-width: 1000px) {
  .nav { display: none; }
  .bnav { display: flex; align-items: stretch; justify-content: space-between; gap: 2px; box-sizing: border-box; position: fixed; z-index: 80; left: 10px; right: 10px; max-width: 480px; margin: 0 auto; bottom: calc(10px + env(safe-area-inset-bottom, 0px)); padding: 7px; border-radius: 30px; }
  .bnav a { flex: 1 1 0; min-width: 0; height: 56px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; border-radius: 20px; color: var(--mut); text-decoration: none; transition: background .4s var(--smooth), color .4s var(--smooth); }
  .bnav a span { font-size: 10.5px; font-weight: 700; line-height: 1; white-space: nowrap; }
  .bnav a.on { color: var(--blue); }
  .bnav a.reg { background: var(--blue); color: #fff; box-shadow: 0 8px 18px rgba(61,59,255,.35); }
}