*, *::before, *::after { box-sizing: border-box; }
:root { --blue: #3d3bff; --ink: #0b1030; --mut: #5b6180; --gold: #ffc531; }
html { scroll-behavior: smooth; }
body { margin: 0; color: var(--ink); background: #f6f7ff; -webkit-font-smoothing: antialiased; }
a { color: inherit; text-decoration: none; }
button { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; }
img { max-width: 100%; }

.btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 15px 26px; border-radius: 99px; font-weight: 700; font-size: 15px; cursor: pointer; }
.btn--dark { background: var(--ink); color: #fff; }

.ph { display: block; width: 100%; height: 100%; background: linear-gradient(135deg, #9db4ff, #4f5cff); }

/* ===== GLOBAL POLISH v4 ===== */
html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
html, body { max-width: 100%; overflow-x: clip; margin: 0; padding: 0; }
main { min-height: 100svh; display: flex; flex-direction: column; }
img, svg, video, iframe { max-width: 100%; height: auto; }
h1, h2, h3 { overflow-wrap: break-word; }

/* Smooth Reveal Animations */
@keyframes riseIn { from { opacity: 0; transform: translateY(30px) } to { opacity: 1; transform: none } }
@supports (animation-timeline: view()) {
  .sec, .cr-wrap, section { animation: riseIn .8s cubic-bezier(.22,1,.36,1) both; animation-timeline: view(); animation-range: entry 0% entry 25%; }
}

/* Perfect Mobile Screen Fit */
@media (max-width: 1000px) {
  .sec { padding-top: 40px !important; padding-bottom: 40px !important; }
  .sec-in, .wrap, .container { padding-left: 16px !important; padding-right: 16px !important; }
  h1 { font-size: clamp(32px, 9vw, 48px) !important; line-height: 1.05 !important; }
  h2 { font-size: clamp(26px, 7.5vw, 38px) !important; line-height: 1.1 !important; }
  p  { font-size: clamp(15px, 4vw, 16px); }
  /* Remove any leftover bottom padding meant for the deleted bottom nav */
  .hero { padding-bottom: 20px !important; }
}
@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, *::before, *::after { animation-duration: .001ms !important; transition-duration: .001ms !important; }
}